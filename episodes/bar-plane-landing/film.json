  "sentences": [
    {
      "text": "Stealing a plane in New York should get you twenty years in prison.",
      "words": [
        0,
        12
      ],
      "subject": "prison_padlock_prop"
    },
    {
      "text": "This guy did it twice, and only paid a hundred bucks.",
      "words": [
        13,
        23
      ],
      "subject": "tommy"
    },
    {
      "text": "In nineteen fifty-six, drunk pilot Tommy Fitzpatrick slammed his beer mug down at O'Malley's Bar.",
      "words": [
        24,
        38
      ],
      "subject": "tommy"
    },
    {
      "text": "He made a crazy bet he could fly from New Jersey to Manhattan in fifteen minutes flat.",
      "words": [
        39,
        55
      ],
      "subject": "stopwatch_bet_sign"
    },
    {
      "text": "Nobody at the crowded table believed a word of his wild boast.",
      "words": [
        56,
        67
      ],
      "subject": "patron"
    },
    {
      "text": "So at three in the morning, Tommy crept across a moonlit New Jersey airfield.",
      "words": [
        68,
        81
      ],
      "subject": "tommy"
    },
    {
      "text": "He broke inside a tiny propeller plane and blasted off into the night with zero lights.",
      "words": [
        82,
        97
      ],
      "subject": "vintage_prop_plane"
    },
    {
      "text": "Tommy raced blind between glowing Manhattan skyscrapers straight toward Washington Heights.",
      "words": [
        98,
        108
      ],
      "subject": "vintage_prop_plane"
    },
    {
      "text": "He plunged straight down a narrow New York avenue lined with parked vintage cars.",
      "words": [
        109,
        122
      ],
      "subject": "vintage_prop_plane"
    },
    {
      "text": "Rubber tires screeched across dark asphalt right outside O'Malley's front door.",
      "words": [
        123,
        133
      ],
      "subject": "vintage_prop_plane"
    },
    {
      "text": "Tommy casually strolled back inside grinning while his friend's jaw hit the floor.",
      "words": [
        134,
        146
      ],
      "subject": "patron"
    },
    {
      "text": "Cops surrounded the plane fast, yet the shocked owner refused to press charges.",
      "words": [
        147,
        159
      ],
      "subject": "officer"
    },
    {
      "text": "So a courtroom judge slammed his gavel and handed Tommy a hundred-dollar fine.",
      "words": [
        160,
        172
      ],
      "subject": "court_judge_gavel"
    },
    {
      "text": "Headlines made him famous, until two years later a new patron called him a liar.",
      "words": [
        173,
        187
      ],
      "subject": "headline_newspaper_prop"
    },
    {
      "text": "So Tommy walked outside and parked a second plane at the exact same bar twice!",
      "words": [
        188,
        202
      ],
      "subject": "vintage_prop_plane"
    }
  ],
